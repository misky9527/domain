# Frontend Dockerfile  
FROM node:22-alpine AS builder
WORKDIR /app
COPY ant-client/package*.json ./
RUN npm install
COPY ant-client/ ./
RUN npx vite build

FROM node:22-alpine AS runner
WORKDIR /app
RUN npm install -g http-server
COPY --from=builder /app/dist ./dist
EXPOSE 5173
CMD ["http-server", "dist", "-p", "5173", "--cors"]
